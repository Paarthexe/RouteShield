# RouteShield Environment Configuration

# Service Port & Host
HOST=0.0.0.0
PORT=8000

# Mireye Geocoding API Credentials (Optional - Falls back to OpenStreetMap Nominatim if empty)
MIREYE_API_KEY=
MIREYE_BASE_URL=https://api.mireye.com/v1

# OSRM Routing Engine URL
OSRM_BASE_URL=http://router.project-osrm.org

# Physical Distance Route Sampling Interval (in meters)
ROUTE_SAMPLE_INTERVAL_M=500

# Cache Settings
CACHE_DB_PATH=./data/routeshield_cache.db
ENABLE_CACHE=true
