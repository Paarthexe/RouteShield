# RouteShield Environment Configuration

# Service Port & Host
HOST=0.0.0.0
PORT=8000

# Mireye Geocoding & Hazard Probing Credentials (Optional - Fallback to synthetic hazard simulation if empty)
MIREYE_API_KEY=
MIREYE_BASE_URL=https://api.mireye.com/v1
MIREYE_MAX_PROBES=6
MIREYE_MAX_CONCURRENCY=4

# OSRM Routing Engine URL
OSRM_BASE_URL=http://router.project-osrm.org

# Physical Distance Route Sampling Interval (in meters)
ROUTE_SAMPLE_INTERVAL_M=500

# Cache Settings (SQLite-backed with configurable TTL)
CACHE_DB_PATH=./data/routeshield_cache.db
ENABLE_CACHE=true
CACHE_TTL_S=3600

# Security & Rate Limiting
CORS_ORIGINS=*
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_DEFAULT=120/minute
